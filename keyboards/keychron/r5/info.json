{
    "keyboard_name": "Keychron R5",
    "manufacturer": "Keychron",
    "url": "https://github.com/Keychron",
    "maintainer": "Keychron",
    "processor": "WB32F3G71",
    "bootloader": "wb32-dfu",
    "usb": {
        "vid": "0x3434"
    },
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "raw": true,
        "rgb_matrix": true,
        "send_string": true
    },
    "diode_direction": "ROW2COL",
    "matrix_size": {
        "rows": 6,
        "cols": 18
    },
    "build": {
        "debounce_type": "custom"
    },
    "debounce": 50,
    "eeprom": {
        "driver": "i2c"
    },
    "indicators": {
        "caps_lock": "B15",
        "on_state": 0
    },
    "matrix_pins": {
        "rows": ["C12", "D2", "B3", "B4", "B5", "B6"],
        "cols": ["A15", "C10", "C11", "B7", "C13", "C14", "C15", "C0", "A0", "A1", null, null, null, null, null, null, null, null],
        "custom": true,
        "custom_lite": true
    },
    "rgb_matrix": {
        "driver": "snled27351_spi",
        "sleep":true,
        "animations": {
            "breathing": true,
            "band_spiral_val": true,
            "cycle_all": true,
            "cycle_left_right": true,
            "cycle_up_down": true,
            "rainbow_moving_chevron": true,
            "cycle_out_in": true,
            "cycle_out_in_dual": true,
            "cycle_pinwheel": true,
            "cycle_spiral": true,
            "dual_beacon": true,
            "rainbow_beacon": true,
            "jellybean_raindrops": true,
            "pixel_rain": true,
            "typing_heatmap": true,
            "digital_rain": true,
            "solid_reactive_simple": true,
            "solid_reactive_multiwide": true,
            "solid_reactive_multinexus": true,
            "splash": true,
            "solid_splash": true
        }
    }
}
